{
  "name": "niuma-payday",
  "version": "1.5.1",
  "private": true,
  "description": "牛马鼓励器 · 让每一秒努力都有回响",
  "author": "Niuma Studio",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "dev": "node scripts/desktop-dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
