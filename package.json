  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "8.3.6",
    "typescript": "^5.9.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "koffi": "2.16.3",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.58.0"
  }
}
